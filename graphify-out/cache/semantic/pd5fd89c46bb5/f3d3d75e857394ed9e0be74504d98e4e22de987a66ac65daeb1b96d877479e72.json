{"nodes": [{"id": "web_reset_password_index_page", "label": "Password Reset Web Page", "file_type": "document", "source_file": "web/reset-password/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosted outside the app so a recovery link opens in a browser; mirrors the Aurora sheet visual language in plain HTML/CSS."}, {"id": "web_reset_password_index_showscreen", "label": "showScreen", "file_type": "code", "source_file": "web/reset-password/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-active-screen state machine over four state divs. Iterating a map that held a lookup for a deleted screen made it throw on null.classList and strand the page on the spinner."}, {"id": "web_reset_password_index_screens", "label": "screens Element Map", "file_type": "code", "source_file": "web/reset-password/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must stay in sync with the markup: every key needs a real element or showScreen degrades."}, {"id": "web_reset_password_index_showfatalerror", "label": "showFatalError", "file_type": "code", "source_file": "web/reset-password/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global last-resort surface wired to window error and unhandledrejection. Touches the DOM directly so it stays callable before later const declarations exist."}, {"id": "web_reset_password_index_mapupdatepassworderror", "label": "mapUpdatePasswordError", "file_type": "code", "source_file": "web/reset-password/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps GoTrue error_code to Arabic copy; raw English server text never reaches the screen."}, {"id": "web_reset_password_index_error_code_messages", "label": "ERROR_CODE_MESSAGES", "file_type": "code", "source_file": "web/reset-password/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyed on GoTrue error_code: same_password and weak_password."}, {"id": "web_reset_password_index_toggle_visibility", "label": "Password Visibility Toggle", "file_type": "code", "source_file": "web/reset-password/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swaps between an open eye and a slashed eye via a revealed class, because flipping input.type alone left the icon static."}, {"id": "web_reset_password_index_recovery_verify", "label": "Recovery Token Verification", "file_type": "code", "source_file": "web/reset-password/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "verifyOtp with type recovery, run from JS on load so email scanners that only prefetch HTML cannot burn the token. Confirms the account's email as a server-side side effect."}, {"id": "web_reset_password_index_scanner_defense", "label": "JS-Execution Scanner Defense", "file_type": "rationale", "source_file": "web/reset-password/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requiring real script execution rather than an HTTP GET is what stops email security scanners from consuming single-use recovery links."}], "edges": [{"source": "web_reset_password_index_page", "target": "web_reset_password_index_showscreen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "web/reset-password/index.html", "source_location": null, "weight": 1.0}, {"source": "web_reset_password_index_showscreen", "target": "web_reset_password_index_screens", "relation": "shares_data_wi